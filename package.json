{
  "scripts": {
    "dev": "zola serve & bunx @tailwindcss/cli -i styles.css -o static/styles.css --watch",
    "dev-mobile": "zola serve --interface 0.0.0.0 --base-url 192.168.1.20 & bunx @tailwindcss/cli -i styles.css -o static/styles.css --watch",
    "pretty": "bunx prettier --write content/ README.md",
    "prod": "NODE_ENV=production bunx @tailwindcss/cli -i styles.css -o static/styles.css --minify; zola build"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "postcss-nested": "^7.0.2",
    "tailwindcss": "^4.1.3"
  },
  "devDependencies": {
    "prettier": "3.2.4"
  }
}
